# ==========================================
# INTERNFLOW MASTER ENVIRONMENT CONFIGURATION
# ==========================================

# ==========================================
# APPLICATION & SERVER
# ==========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
INTERNFLOW_DEMO_DATA=true


# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
INTERNFLOW_DB_PATH=internflow.db


# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
INTERNFLOW_JWT_SECRET=your-production-jwt-secret-change-me
JWT_EXPIRE_MINUTES=1440
INTERNFLOW_JWT_EXPIRE_MINUTES=1440
PROVIDER_ALLOWED_EMAIL_DOMAINS=
MENTOR_ALLOWED_EMAIL_DOMAINS=


# ==========================================
# GEMINI AI ENGINE (gemini-2.0-flash)
# ==========================================
INTERNFLOW_GEMINI_API_KEY=your-gemini-api-key-here
INTERNFLOW_GEMINI_API_KEY_1=
INTERNFLOW_GEMINI_API_KEY_2=
INTERNFLOW_GEMINI_API_KEY_3=
GEMINI_API_KEY=
INTERNFLOW_GEMINI_MODEL=gemini-2.0-flash


# ==========================================
# MAKE.COM MASTER WEBHOOK CONFIGURATION (#1 - #30)
# ==========================================

# Active Verified Make Webhooks
MAKE_APPLICATION_CREATED_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_INTERVIEW_SCHEDULED_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_INTERVIEW_SLOT_BOOKED_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_INTERVIEW_CONFIRMED_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_ONBOARDING_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_INTERNSHIP_START_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_TASK_SUBMITTED_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_WEEKLY_REPORT_NOTIFICATION_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_FEEDBACK_APPROVED_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_CERTIFICATE_EMAIL_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID

# Legacy Webhook URL Fallback
INTERNFLOW_MAKE_INTERVIEW_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK_ID
MAKE_WEEKLY_REPORT_READY_WEBHOOK_URL=
MAKE_CERTIFICATE_ISSUED_WEBHOOK_URL=

# Standby / Unbuilt Make Webhook URLs
MAKE_CANDIDATE_SHORTLISTED_WEBHOOK_URL=
MAKE_CANDIDATE_REJECTED_WEBHOOK_URL=
MAKE_ASSESSMENT_INVITED_WEBHOOK_URL=
MAKE_ASSESSMENT_RESULT_WEBHOOK_URL=
MAKE_INTERVIEW_REMINDER_WEBHOOK_URL=
MAKE_SELECTION_NOTIFICATION_WEBHOOK_URL=
MAKE_ONBOARDING_REMINDER_WEBHOOK_URL=
MAKE_TASK_DEADLINE_WEBHOOK_URL=
MAKE_TASK_REVIEW_REMINDER_WEBHOOK_URL=
MAKE_ATTENDANCE_REMINDER_WEBHOOK_URL=
MAKE_AI_MENTOR_FEEDBACK_WEBHOOK_URL=
MAKE_EVALUATION_REMINDER_WEBHOOK_URL=
MAKE_PROVIDER_NOTIFICATION_WEBHOOK_URL=
MAKE_AUTOMATION_FAILURE_WEBHOOK_URL=
MAKE_COMPLETION_WORKFLOW_WEBHOOK_URL=
MAKE_SCHEDULED_CLEANUP_WEBHOOK_URL=


# ==========================================
# PRODUCTION SMTP EMAIL DELIVERY
# ==========================================
INTERNFLOW_SMTP_HOST=smtp.sendgrid.net
INTERNFLOW_SMTP_PORT=587
INTERNFLOW_SMTP_USERNAME=your-smtp-username
INTERNFLOW_SMTP_PASSWORD=your-smtp-password
INTERNFLOW_EMAIL_FROM=notifications@internflow.com
INTERNFLOW_SMTP_USE_TLS=true
